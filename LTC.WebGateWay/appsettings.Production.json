{
  "ReverseProxy": {
    "Routes": {
      "ltc-administration": {
        "ClusterId": "administration-service",
        "Match": {
          "Path": "/ltc/administration-service/{**catch-all}"
        }
      },
      "administration-service-direct": {
        "ClusterId": "administration-service",
        "Match": {
          "Path": "/administration-service/{**catch-all}"
        }
      },
      "ltc-customer-service": {
        "ClusterId": "customer-service",
        "Match": {
          "Path": "/ltc/customer-service/{**catch-all}"
        }
      },
      "customer-service-direct": {
        "ClusterId": "customer-service",
        "Match": {
          "Path": "/customer-service/{**catch-all}"
        }
      },
      "ltc-movie-service": {
        "ClusterId": "movie-service",
        "Match": {
          "Path": "/ltc/movie-service/{**catch-all}"
        }
      },
      "movie-service-direct": {
        "ClusterId": "movie-service",
        "Match": {
          "Path": "/movie-service/{**catch-all}"
        }
      },
      "ltc-notification-service": {
        "ClusterId": "notification-service",
        "Match": {
          "Path": "/ltc/notification-service/{**catch-all}"
        }
      },
      "notification-service-direct": {
        "ClusterId": "notification-service",
        "Match": {
          "Path": "/notification-service/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "administration-service": {
        "Destinations": {
          "Default": {
            "Address": "http://ltt-ltc-administration-api:8080",
            "Swaggers": [
              {
                "PrefixPath": "/ltc/administration-service",
                "Paths": [
                  "/ltc/administration-service/swagger/v1/swagger.json"
                ]
              }
            ]
          }
        }
      },
      "customer-service": {
        "Destinations": {
          "Default": {
            "Address": "http://ltt-ltc-customer-api:8080",
            "Swaggers": [
              {
                "PrefixPath": "/ltc/customer-service",
                "Paths": [
                  "/ltc/customer-service/swagger/v1/swagger.json"
                ]
              }
            ]
          }
        }
      },
      "movie-service": {
        "Destinations": {
          "Default": {
            "Address": "http://ltt-ltc-movie-api:8080",
            "Swaggers": [
              {
                "PrefixPath": "/ltc/movie-service",
                "Paths": [
                  "/ltc/movie-service/swagger/v1/swagger.json"
                ]
              }
            ]
          }
        }
      },
      "notification-service": {
        "Destinations": {
          "Default": {
            "Address": "http://ltt-ltc-notification-api:8080",
            "Swaggers": [
              {
                "PrefixPath": "/ltc/notification-service",
                "Paths": [
                  "/ltc/notification-service/swagger/v1/swagger.json"
                ]
              }
            ]
          }
        }
      }
    }
  }
}
