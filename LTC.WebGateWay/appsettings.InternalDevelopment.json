{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "ltc-administration": {
        "ClusterId": "administration-service",
        "Match": {
          "Path": "/ltc/administration-service/{**catch-all}"
        }
      },
      "ltc-customer-service": {
        "ClusterId": "customer-service",
        "Match": {
          "Path": "/ltc/customer-service/{**catch-all}"
        }
      },
      "ltc-movie-service": {
        "ClusterId": "movie-service",
        "Match": {
          "Path": "/ltc/movie-service/{**catch-all}"
        }
      },
      "ltc-product-service": {
        "ClusterId": "product-service",
        "Match": {
          "Path": "/ltc/product-service/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "administration-service": {
        "Destinations": {
          "Default": {
            "Address": "http://ltt-ltc-administration-api:8088",
            "Swaggers": [
              {
                "PrefixPath": "/ltc/administration-service",
                "Paths": [
                  "/ltc/administration-service/swagger/v1/swagger.json"
                ]
              }
            ]
          }
        }
      },
      "customer-service": {
        "Destinations": {
          "Default": {
            "Address": "http://ltt-ltc-customer-api:43320",
            "Swaggers": [
              {
                "PrefixPath": "/ltc/customer-service",
                "Paths": [
                  "/ltc/customer-service/swagger/v1/swagger.json"
                ]
              }
            ]
          }
        }
      },
      "movie-service": {
        "Destinations": {
          "Default": {
            "Address": "http://ltt-ltc-movie-service:80",
            "Swaggers": [
              {
                "PrefixPath": "/ltc/movie-service",
                "Paths": [
                  "/ltc/movie-service/swagger/v1/swagger.json"
                ]
              }
            ]
          }
        }
      },
      "product-service": {
        "Destinations": {
          "Default": {
            "Address": "http://ltt-ltc-product-service:80",
            "Swaggers": [
              {
                "PrefixPath": "/ltc/product-service",
                "Paths": [
                  "/ltc/product-service/swagger/v1/swagger.json"
                ]
              }
            ]
          }
        }
      }
    }
  }
}